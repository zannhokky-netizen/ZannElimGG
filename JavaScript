// LOGIN ADMIN
app.post("/api/admin/login", async (req, res) => {
  const { password } = req.body;

  if (
    typeof password !== "string" ||
    !await bcrypt.compare(
      password,
      await bcrypt.hash(process.env.ADMIN_PASSWORD, 10)
    ).catch(() => false)
  ) {
    // Gunakan perbandingan hash pada produksi.
    if (password !== process.env.ADMIN_PASSWORD) {
      return res.status(401).json({
        error: "Password admin salah."
      });
    }
  }

  res.json({
    token: token({ role: "admin" }),
    role: "admin"
  });
});

// ADMIN MEMBUAT KEY
app.post("/api/admin/keys", auth, admin, (req, res) => {
  const { quantity, days } = req.body;
  const count = Number(quantity);

  if (!Number.isInteger(count) || count < 1 || count > 1000) {
    return res.status(400).json({
      error: "Jumlah KEY harus 1 sampai 1000 per permintaan."
    });
  }

  if (![3, 7, 30, 0].includes(Number(days))) {
    return res.status(400).json({ error: "Paket tidak valid." });
  }

  const create = db.transaction(() => {
    const result = [];

    for (let i = 0; i < count; i++) {
      const code = makeKey();

      db.prepare(`
        INSERT INTO keys_table (code, duration, permanent)
        VALUES (?, ?, ?)
      `).run(code, days, days === 0 ? 1 : 0);

      result.push(code);
    }

    return result;
  });

  res.json({ keys: create() });
});

// LOGIN MENGGUNAKAN KEY
app.post("/api/login", (req, res) => {
  const code = String(req.body.key || "").trim().toUpperCase();

  const key = db.prepare(`
    SELECT * FROM keys_table WHERE code = ?
  `).get(code);

  if (!key) {
    return res.status(401).json({ error: "KEY tidak ditemukan." });
  }

  if (["EXPIRED", "CANCELLED"].includes(key.status)) {
    return res.status(403).json({ error: "KEY tidak berlaku." });
  }

  if (key.status === "ACTIVE" &&
      !key.permanent && key.expires_at <= Date.now()) {
    db.prepare("UPDATE keys_table SET status='EXPIRED' WHERE id=?")
      .run(key.id);

    return res.status(403).json({ error: "KEY kedaluwarsa." });
  }

  let userId = key.user_id;

  if (key.status === "UNUSED") {
    const username = "user_" + crypto.randomBytes(6).toString("hex");

    const info = db.prepare(`
      INSERT INTO users (username) VALUES (?)
    `).run(username);

    userId = Number(info.lastInsertRowid);

    const now = Date.now();
    const expires = key.permanent
      ? null
      : now + key.duration * 24 * 60 * 60 * 1000;

    db.prepare(`
      UPDATE keys_table
      SET user_id=?, status='ACTIVE',
          activated_at=?, expires_at=?
      WHERE id=?
    `).run(userId, now, expires, key.id);
  }

  res.json({
    token: token({ id: userId, role: "user" }),
    role: "user",
    permanent: Boolean(key.permanent),
    expiresAt: key.expires_at
  });
});

