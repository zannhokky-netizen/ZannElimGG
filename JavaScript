// ADMIN VERIFIKASI PEMBAYARAN
app.post("/api/admin/orders/:id/verify", auth, admin, (req, res) => {
  const issue = db.transaction(() => {
    const order = db.prepare(`
      SELECT * FROM orders WHERE id=?
    `).get(Number(req.params.id));

    if (!order) throw new Error("Transaksi tidak ditemukan.");

    if (order.status === "PAID") {
      throw new Error("Transaksi sudah diproses.");
    }

    if (order.status !== "PENDING") {
      throw new Error("Status transaksi tidak dapat diverifikasi.");
    }

    const keys = [];

    for (let i = 0; i < order.quantity; i++) {
      const code = makeKey();

      db.prepare(`
        INSERT INTO keys_table (code, duration, permanent)
        VALUES (?, ?, ?)
      `).run(code, order.duration, order.duration === 0 ? 1 : 0);

      keys.push(code);
    }

    db.prepare(`
      UPDATE orders SET status='PAID' WHERE id=?
    `).run(order.id);

    return keys;
  });

  try {
    res.json({
      status: "PAID",
      keys: issue()
    });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

