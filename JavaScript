  });

// TIMER GAME
app.post("/api/hosts/:hostId/timer",
  auth, activeKey, ownHost, (req, res) => {
    const seconds = Number(req.body.seconds);
    const locked = Boolean(req.body.locked);
    const gameType = req.body.gameType === "auction"
      ? "auction" : "elimination";

    if (!Number.isInteger(seconds) || seconds < 1 ||
        seconds > 86400) {
      return res.status(400).json({ error: "Durasi tidak valid." });
    }

    const endsAt = Date.now() + seconds * 1000;

    const info = db.prepare(`
      INSERT INTO game_sessions
      (host_id, game_type, status, duration, ends_at, locked)
      VALUES (?, ?, 'RUNNING', ?, ?, ?)
    `).run(
      req.host.id, gameType, seconds, endsAt,
      locked ? 1 : 0
    );

    res.json({
      sessionId: Number(info.lastInsertRowid),
      gameType,
      status: "RUNNING",
      endsAt,
      locked
    });
  });

// STATUS TIMER
app.get("/api/hosts/:hostId/timer/:type",
  auth, activeKey, ownHost, (req, res) => {
    const type = req.params.type === "auction"
      ? "auction" : "elimination";

    const session = db.prepare(`
      SELECT * FROM game_sessions
      WHERE host_id=? AND game_type=?
      ORDER BY id DESC LIMIT 1
    `).get(req.host.id, type);

    if (!session) {
      return res.json({ status: "IDLE" });
    }

    const remaining = session.status === "RUNNING"
      ? Math.max(0, Math.ceil((session.ends_at - Date.now()) / 1000))
      : 0;

    if (session.status === "RUNNING" && remaining === 0) {
      db.prepare(`
        UPDATE game_sessions SET status='FINISHED'
        WHERE id=?
      `).run(session.id);

      session.status = "FINISHED";
    }

    res.json({
      status: session.status,
      remaining,
      locked: Boolean(session.locked)
    });
  });

