// STORE: BUAT TRANSAKSI
app.post("/api/orders", (req, res) => {
  const { days, quantity, buyer } = req.body;
  const plan = PRICES[Number(days)];
  const count = Number(quantity);

  if (!plan || !Number.isInteger(count) ||
      count < 1 || count > 100) {
    return res.status(400).json({
      error: "Paket atau jumlah KEY tidak valid."
    });
  }

  if (typeof buyer !== "string" || buyer.trim().length < 2 ||
      buyer.length > 60) {
    return res.status(400).json({
      error: "Nama pembeli tidak valid."
    });
  }

  const orderCode = "ZVIP-" +
    crypto.randomBytes(5).toString("hex").toUpperCase();

  const info = db.prepare(`
    INSERT INTO orders
    (order_code, quantity, total, duration)
    VALUES (?, ?, ?, ?)
  `).run(orderCode, count, count * plan.price, Number(days));

  res.json({
    id: info.lastInsertRowid,
    orderCode,
    buyer: buyer.trim(),
    quantity: count,
    total: count * plan.price,
    payment: "Transfer manual",
    destination: process.env.PAYMENT_PHONE,
    status: "PENDING",
    message: "Selesaikan pembayaran lalu tunggu verifikasi admin."
  });
});

