
require("dotenv").config();

const express = require("express");
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");
const crypto = require("crypto");
const helmet = require("helmet");
const cors = require("cors");
const rateLimit = require("express-rate-limit");
const db = require("./database");

const app = express();

app.use(helmet());
app.use(cors());
app.use(express.json({ limit: "1mb" }));
app.use(express.static("public"));

app.use("/api", rateLimit({
  windowMs: 60 * 1000,
  limit: 100
}));

const PORT = process.env.PORT || 3000;
const SECRET = process.env.JWT_SECRET;

if (!SECRET || SECRET.length < 32 ||
    !process.env.ADMIN_PASSWORD) {
  throw new Error("Konfigurasi rahasia server belum benar.");
}

const PRICES = {
  3: { price: 5000, days: 3 },
  7: { price: 10000, days: 7 },
  30: { price: 40000, days: 30 },
  0: { price: 100000, days: 0 }
};

function makeKey() {
  return "ZANN-" +
    crypto.randomBytes(12).toString("hex").toUpperCase();
}

function token(payload) {
  return jwt.sign(payload, SECRET, { expiresIn: "12h" });
}

function auth(req, res, next) {
  try {
    const value = req.headers.authorization || "";
    const t = value.startsWith("Bearer ")
      ? value.slice(7) : "";

    req.user = jwt.verify(t, SECRET);
    next();
  } catch {
    res.status(401).json({ error: "Silakan login kembali." });
  }
}

function admin(req, res, next) {
  if (req.user.role !== "admin") {
    return res.status(403).json({ error: "Akses admin ditolak." });
  }
  next();
}

function activeKey(req, res, next) {
  if (req.user.role === "admin") return next();

  const key = db.prepare(`
    SELECT * FROM keys_table
    WHERE user_id = ? AND status = 'ACTIVE'
    ORDER BY id DESC LIMIT 1
  `).get(req.user.id);

  if (!key) {
    return res.status(403).json({
      error: "KEY tidak aktif. Silakan beli atau gunakan KEY."
    });
  }

  if (!key.permanent && key.expires_at <= Date.now()) {
    db.prepare(`
      UPDATE keys_table SET status = 'EXPIRED'
      WHERE id = ?
    `).run(key.id);

    return res.status(403).json({
      error: "MASA AKTIF KEY HABIS. Akses game ditutup."
    });
  }

  req.activeKey = key;
  next();
}

function ownHost(req, res, next) {
  const host = db.prepare(`
    SELECT * FROM hosts WHERE id = ? AND owner_id = ?
  `).get(Number(req.params.hostId), req.user.id);

  if (!host) {
    return res.status(404).json({
      error: "Host tidak ditemukan."
    });
  }

  req.host = host;
  next();
}

